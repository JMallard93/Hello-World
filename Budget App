def create_spend_chart(categories):
    #calculate and store category spending
    all_spending = []
    for category in categories:
        category_total = 0
        for dictionary in category.ledger:
            if dictionary["amount"] < 0:
                category_total += abs(dictionary["amount"])
        category_spending = {"category": category, "amount": category_total}
        all_spending.append(category_spending)
    
    #getting the grand total
    grand_total = 0
    for dictionary in all_spending:
        grand_total += dictionary["amount"]

    #spend percentages
    category_percentages = []
    if grand_total > 0:
        for dictionary in all_spending:
            calculated_percentage = (((dictionary["amount"] / grand_total) * 100) // 10) * 10
            category_percentage = {"category": dictionary["category"], "percentage": calculated_percentage}
            category_percentages.append(category_percentage)

    #category names for bottom of chart
    category_names = []
    for dictionary in category_percentages:
        category_names.append(dictionary["category"].name)

    #building the chart
    #y axis and bars
    chart = ""
    chart += "Percentage spent by category\n"
    for i in range(100, -1, -10):
        chart += str(i).rjust(3) + "| "
        for dictionary in category_percentages:
            if dictionary["percentage"] >= i:
                chart += "o  "
            else:
                chart += "   "
        chart += "\n"

    #horizontal divider
    horizontal_line = (len(category_names) * 3) +1
    chart += "    " + ("-" * horizontal_line) + "\n"

    #category names printed vertically
    for letters in itertools.zip_longest(*category_names, fillvalue = " "):
        chart += "     " + "  ".join(letters) + "  \n"
    
    return chart.rstrip("\n")

print(create_spend_chart([food, auto, insurance]))
