#Budget App

import math
import itertools

class Category:
    def __init__(self, name):
        self.name = name
        self.ledger = []

    def get_balance(self):
        total = 0
        for transaction in self.ledger:
            total += transaction["amount"]
        return total

    def check_funds(self, amount):
        if self.get_balance() < amount:
            return False
        else:
            return True
   
    def deposit(self, amount, description = ""):
        user_deposit = {'amount': amount, 'description': description}
        self.ledger.append(user_deposit)

    def withdraw(self, amount, description = ""):
        if self.check_funds(amount):
            amount = -abs(amount)
            user_withdraw = {'amount': amount, 'description': description}
            self.ledger.append(user_withdraw)
            return True
        else:
            return False

    def transfer(self, amount, category):
        if self.withdraw(amount, f"Transfer to {category.name}"):
            category.deposit(amount, f"Transfer from {self.name}")
            return True
        else:
            return False

   

    def __str__(self):
        output = []
        title = self.name.center(30, "*")
        output.append(title)
        for transaction in self.ledger:
            amount = transaction["amount"]
            amount_string = f"{amount:.2f}"
            description = transaction["description"]
            output.append(description[:23].ljust(23) + amount_string.rjust(7))
        total = f"Total: {self.get_balance()}"
        output.append(total)
        formatted_list = "\n".join(output)
        return formatted_list

